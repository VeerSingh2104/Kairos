APP_ENV=development
REQUIRE_AUTH=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

MAX_RESUME_CHARS=120000

# Required when REQUIRE_AUTH=true.
# Use either GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# or put the service-account JSON object in FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

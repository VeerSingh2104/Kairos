APP_ENV=development
REQUIRE_AUTH=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

MAX_RESUME_CHARS=120000

# Local development: path to the Firebase Admin SDK service-account JSON.
# Keep this file outside the repository.
# Example on Windows:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YourName/Downloads/kairos-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Production alternative for secret managers:
# Put the complete service-account JSON object in this variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

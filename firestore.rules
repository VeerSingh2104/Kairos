rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleIs(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || roleIs('admin') || roleIs('manager'));
      allow update: if signedIn() && (request.auth.uid == uid || roleIs('admin'));
      allow delete: if roleIs('admin');
    }

    match /resumeAnalyses/{id} {
      allow create, read: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /jobs/{id} {
      allow read: if signedIn();
      allow create: if roleIs('manager') && request.resource.data.managerId == request.auth.uid;
      allow update, delete: if roleIs('manager') && resource.data.managerId == request.auth.uid;
    }

    match /applications/{id} {
      allow create: if roleIs('candidate') && request.resource.data.candidateId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.candidateId == request.auth.uid
          || roleIs('admin')
          || (roleIs('manager') && resource.data.managerId == request.auth.uid));
      allow update: if roleIs('admin')
        || (roleIs('manager') && resource.data.managerId == request.auth.uid);
    }
  }
}
